{
	"tool": {"body": "@tool\n|CURSOR|", "description": "Run the script in the editor (@tool)", "category": "Script"},
	"class": {"body": "class_name {name}\nextends {parent=Node}\n\n|CURSOR|", "description": "class_name and extends header", "category": "Script"},
	"region": {"body": "#region {name}\n{selection}|CURSOR|\n#endregion", "description": "Foldable region, wraps the selected code", "category": "Script"},
	"todo": {"body": "# TODO: |CURSOR|", "description": "TODO comment", "category": "Script"},
	"fixme": {"body": "# FIXME: |CURSOR|", "description": "FIXME comment", "category": "Script"},
	"note": {"body": "# NOTE: |CURSOR|", "description": "NOTE comment", "category": "Script"},

	"export": {"body": "@export var {name}: {type=float}|CURSOR|", "description": "Exported variable (@export)", "category": "Variables"},
	"exprange": {"body": "@export_range({min=0}, {max=100}) var {name}: {type=float} = |CURSOR|", "description": "Exported variable with a range slider (@export_range)", "category": "Variables"},
	"expnode": {"body": "@export var {name}: {node_type=Node} = |CURSOR|", "description": "Exported node reference", "category": "Variables"},
	"expgroup": {"body": "@export_group(\"{name}\")\n|CURSOR|", "description": "Group the following exported variables in the inspector", "category": "Variables"},
	"expenum": {"body": "@export_enum(\"{a=A}\", \"{b=B}\") var {name}: String = \"{a}\"|CURSOR|", "description": "Exported string picked from a list (@export_enum)", "category": "Variables"},
	"expmulti": {"body": "@export_multiline var {name}: String|CURSOR|", "description": "Exported multiline text (@export_multiline)", "category": "Variables"},
	"expfile": {"body": "@export_file var {name}: String = \"|CURSOR|\"", "description": "Exported file path (@export_file)", "category": "Variables"},
	"onready": {"body": "@onready var {name}: {type=Node} = ${path}|CURSOR|", "description": "@onready variable with a $NodePath", "category": "Variables"},
	"onrget": {"body": "@onready var {name}: {type=Node} = get_node(\"{path}\")|CURSOR|", "description": "@onready variable with get_node()", "category": "Variables"},
	"const": {"body": "const {name}: {type=int} = |CURSOR|", "description": "Typed constant", "category": "Variables"},
	"array": {"body": "var {name}: Array[{type=int}] = []|CURSOR|", "description": "Typed array", "category": "Variables"},
	"enum": {"body": "enum {name} {\n\t{value},\n\t|CURSOR|\n}", "description": "Named enum", "category": "Variables"},
	"prop": {"body": "var {name}: {type=float}:\n\tget:\n\t\treturn {name}\n\tset(value):\n\t\t{name} = value\n\t\t|CURSOR|", "description": "Property with getter and setter", "category": "Variables"},
	"propget": {"body": "var {name}: {type=float}:\n\tget:\n\t\treturn |CURSOR|", "description": "Property with a getter", "category": "Variables"},
	"propset": {"body": "var {name}: {type=float}:\n\tset(value):\n\t\t|CURSOR|", "description": "Property with a setter", "category": "Variables"},

	"ready": {"body": "func _ready() -> void:\n\t|CURSOR|", "description": "_ready() - called when the node enters the scene tree", "category": "Functions"},
	"process": {"body": "func _process(delta: float) -> void:\n\t|CURSOR|", "description": "_process() - called every frame", "category": "Functions"},
	"physics": {"body": "func _physics_process(delta: float) -> void:\n\t|CURSOR|", "description": "_physics_process() - called every physics frame", "category": "Functions"},
	"input": {"body": "func _input(event: InputEvent) -> void:\n\t|CURSOR|", "description": "_input() - handle input events", "category": "Functions"},
	"uninput": {"body": "func _unhandled_input(event: InputEvent) -> void:\n\t|CURSOR|", "description": "_unhandled_input() - input not handled by the GUI", "category": "Functions"},
	"draw": {"body": "func _draw() -> void:\n\t|CURSOR|", "description": "_draw() - custom drawing", "category": "Functions"},
	"enter": {"body": "func _enter_tree() -> void:\n\t|CURSOR|", "description": "_enter_tree() - called when entering the scene tree", "category": "Functions"},
	"exit": {"body": "func _exit_tree() -> void:\n\t|CURSOR|", "description": "_exit_tree() - called when leaving the scene tree", "category": "Functions"},
	"notif": {"body": "func _notification(what: int) -> void:\n\tmatch what:\n\t\t|CURSOR|", "description": "_notification() with a match", "category": "Functions"},
	"confwarn": {"body": "func _get_configuration_warnings() -> PackedStringArray:\n\tvar warnings := PackedStringArray()\n\t|CURSOR|\n\treturn warnings", "description": "Node configuration warnings shown in the scene tree", "category": "Functions"},
	"func": {"body": "func {name}({params=}) -> {return_type=void}:\n\t|CURSOR|", "description": "Function with parameters and return type", "category": "Functions"},
	"fv": {"body": "func {name}() -> void:\n\t|CURSOR|", "description": "Function without parameters returning void", "category": "Functions"},
	"static": {"body": "static func {name}({params=}) -> {return_type=void}:\n\t|CURSOR|", "description": "Static function", "category": "Functions"},
	"lambda": {"body": "func({params=}): |CURSOR|", "description": "Lambda function", "category": "Functions"},
	"supercall": {"body": "super.{method}({args=})|CURSOR|", "description": "Call the parent class method", "category": "Functions"},

	"signal": {"body": "signal {name}({params=})|CURSOR|", "description": "Signal declaration", "category": "Signals"},
	"sigcon": {"body": "{signal}.connect(_on_{signal})|CURSOR|", "description": "Connect a signal to _on_<signal>", "category": "Signals"},
	"sigem": {"body": "{signal}.emit({args=})|CURSOR|", "description": "Emit a signal", "category": "Signals"},
	"awaitsig": {"body": "await {signal}\n|CURSOR|", "description": "Wait for a signal", "category": "Signals"},
	"ondis": {"body": "{signal}.disconnect(_on_{signal})|CURSOR|", "description": "Disconnect a signal from _on_<signal>", "category": "Signals"},
	"collbody": {"body": "func _on_{node=area_2d}_body_entered(body: Node2D) -> void:\n\t|CURSOR|", "description": "body_entered signal handler (Area2D)", "category": "Signals"},
	"collarea": {"body": "func _on_{node=area_2d}_area_entered(area: Area2D) -> void:\n\t|CURSOR|", "description": "area_entered signal handler (Area2D)", "category": "Signals"},
	"timeout": {"body": "func _on_{node=timer}_timeout() -> void:\n\t|CURSOR|", "description": "timeout signal handler (Timer)", "category": "Signals"},
	"pressed": {"body": "func _on_{node=button}_pressed() -> void:\n\t|CURSOR|", "description": "pressed signal handler (Button)", "category": "Signals"},

	"if": {"body": "if {condition}:\n\t{selection}|CURSOR|", "description": "if block, wraps the selected code", "category": "Control Flow"},
	"ife": {"body": "if {condition}:\n\t{selection}|CURSOR|\nelse:\n\tpass", "description": "if / else block, wraps the selected code", "category": "Control Flow"},
	"for": {"body": "for {item} in {collection}:\n\t{selection}|CURSOR|", "description": "for loop over a collection, wraps the selected code", "category": "Control Flow"},
	"fori": {"body": "for i in range({count=10}):\n\t{selection}|CURSOR|", "description": "for loop with an index, wraps the selected code", "category": "Control Flow"},
	"while": {"body": "while {condition}:\n\t{selection}|CURSOR|", "description": "while loop, wraps the selected code", "category": "Control Flow"},
	"match": {"body": "match {value}:\n\t{case}:\n\t\t|CURSOR|\n\t_:\n\t\tpass", "description": "match statement with a default case", "category": "Control Flow"},
	"isnull": {"body": "if {value} != null:\n\t{selection}|CURSOR|", "description": "Null check, wraps the selected code", "category": "Control Flow"},
	"isval": {"body": "if is_instance_valid({object}):\n\t{selection}|CURSOR|", "description": "is_instance_valid() check, wraps the selected code", "category": "Control Flow"},
	"guard": {"body": "if not {condition}:\n\treturn|CURSOR|", "description": "Guard clause - return early", "category": "Control Flow"},
	"assert": {"body": "assert({condition}, \"{message}\")|CURSOR|", "description": "Assertion with a message", "category": "Control Flow"},

	"ia": {"body": "Input.is_action_pressed(\"{action}\")|CURSOR|", "description": "Is an input action held down", "category": "Input"},
	"iaj": {"body": "Input.is_action_just_pressed(\"{action}\")|CURSOR|", "description": "Was an input action just pressed", "category": "Input"},
	"iar": {"body": "Input.is_action_just_released(\"{action}\")|CURSOR|", "description": "Was an input action just released", "category": "Input"},
	"iak": {"body": "Input.is_key_pressed(KEY_{key})|CURSOR|", "description": "Is a keyboard key pressed", "category": "Input"},
	"evact": {"body": "if event.is_action_pressed(\"{action}\"):\n\t{selection}|CURSOR|", "description": "Check an input action in _input(), wraps the selected code", "category": "Input"},
	"ims": {"body": "Input.is_mouse_button_pressed(MOUSE_BUTTON_{button=LEFT})|CURSOR|", "description": "Is a mouse button pressed", "category": "Input"},

	"addch": {"body": "add_child({node})|CURSOR|", "description": "Add a child node", "category": "Nodes & Scenes"},
	"remch": {"body": "remove_child({node})|CURSOR|", "description": "Remove a child node", "category": "Nodes & Scenes"},
	"qfree": {"body": "queue_free()|CURSOR|", "description": "Delete the node at the end of the frame", "category": "Nodes & Scenes"},
	"getnode": {"body": "get_node(\"{path}\")|CURSOR|", "description": "Get a node by path", "category": "Nodes & Scenes"},
	"hasnode": {"body": "has_node(\"{path}\")|CURSOR|", "description": "Check if a node exists at a path", "category": "Nodes & Scenes"},
	"findch": {"body": "find_child(\"{name}\", true, false)|CURSOR|", "description": "Find a descendant node by name", "category": "Nodes & Scenes"},
	"gettree": {"body": "get_tree()|CURSOR|", "description": "The SceneTree", "category": "Nodes & Scenes"},
	"getparent": {"body": "get_parent()|CURSOR|", "description": "The parent node", "category": "Nodes & Scenes"},
	"getchildren": {"body": "get_children()|CURSOR|", "description": "All child nodes", "category": "Nodes & Scenes"},
	"inst": {"body": "var {var_name} = {scene}.instantiate()\n|CURSOR|", "description": "Instantiate a PackedScene", "category": "Nodes & Scenes"},
	"load": {"body": "var {var_name} = load(\"{path}\")|CURSOR|", "description": "Load a resource at runtime", "category": "Nodes & Scenes"},
	"preload": {"body": "const {const_name} = preload(\"{path}\")|CURSOR|", "description": "Preload a resource into a constant", "category": "Nodes & Scenes"},
	"chscene": {"body": "get_tree().change_scene_to_file(\"{path=res://}\")|CURSOR|", "description": "Switch to another scene", "category": "Nodes & Scenes"},

	"dict": {"body": "var {name}: Dictionary = {\n\t\"{key}\": |CURSOR|\n}", "description": "Dictionary with one entry", "category": "Dictionaries"},
	"dictempty": {"body": "var {name}: Dictionary = {}|CURSOR|", "description": "Empty dictionary", "category": "Dictionaries"},
	"dicthas": {"body": "if {dict}.has(\"{key}\"):\n\t{selection}|CURSOR|", "description": "Check if a dictionary has a key, wraps the selected code", "category": "Dictionaries"},
	"dictget": {"body": "{dict}.get(\"{key}\", {default=null})|CURSOR|", "description": "Dictionary value with a default", "category": "Dictionaries"},
	"dictkeys": {"body": "for key in {dict}.keys():\n\t|CURSOR|", "description": "Loop over dictionary keys", "category": "Dictionaries"},
	"dictvals": {"body": "for value in {dict}.values():\n\t|CURSOR|", "description": "Loop over dictionary values", "category": "Dictionaries"},
	"dictitems": {"body": "for key in {dict}:\n\tvar value = {dict}[key]\n\t|CURSOR|", "description": "Loop over dictionary keys and values", "category": "Dictionaries"},
	"dictmerge": {"body": "{dict1}.merge({dict2}, true)|CURSOR|", "description": "Merge dictionaries, overwriting existing keys", "category": "Dictionaries"},
	"dictdup": {"body": "var {new_dict} = {dict}.duplicate(true)|CURSOR|", "description": "Deep copy of a dictionary", "category": "Dictionaries"},
	"dicterase": {"body": "{dict}.erase(\"{key}\")|CURSOR|", "description": "Remove a key from a dictionary", "category": "Dictionaries"},
	"dictclear": {"body": "{dict}.clear()|CURSOR|", "description": "Remove all dictionary entries", "category": "Dictionaries"},

	"timer": {"body": "await get_tree().create_timer({seconds=1.0}).timeout\n|CURSOR|", "description": "Wait for a number of seconds", "category": "Timers & Tweens"},
	"calldef": {"body": "call_deferred(\"{method}\", {args=})|CURSOR|", "description": "Call a method at the end of the frame", "category": "Timers & Tweens"},
	"setdef": {"body": "set_deferred(\"{property}\", {value})|CURSOR|", "description": "Set a property at the end of the frame", "category": "Timers & Tweens"},
	"tween": {"body": "var tween = create_tween()\ntween.tween_property({object=self}, \"{property}\", {final_value}, {duration=1.0})\n|CURSOR|", "description": "Tween a property", "category": "Timers & Tweens"},
	"tweencb": {"body": "var tween = create_tween()\ntween.tween_callback({callable})\n|CURSOR|", "description": "Tween with a callback", "category": "Timers & Tweens"},
	"tweenpar": {"body": "var tween = create_tween().set_parallel()\ntween.tween_property({object=self}, \"{prop1}\", {value1}, {duration1=1.0})\ntween.tween_property({object=self}, \"{prop2}\", {value2}, {duration2=1.0})\n|CURSOR|", "description": "Tween two properties at the same time", "category": "Timers & Tweens"},

	"print": {"body": "print({value})|CURSOR|", "description": "Print a value", "category": "Debug"},
	"printd": {"body": "print(\"{var}: \", {var})|CURSOR|", "description": "Print a value with its name", "category": "Debug"},
	"printerr": {"body": "push_error({message})|CURSOR|", "description": "Report an error (push_error)", "category": "Debug"},
	"printwarn": {"body": "push_warning({message})|CURSOR|", "description": "Report a warning (push_warning)", "category": "Debug"},

	"vec": {"body": "Vector2({x=0}, {y=0})|CURSOR|", "description": "Vector2", "category": "Math & Types"},
	"vei": {"body": "Vector2i({x=0}, {y=0})|CURSOR|", "description": "Vector2i", "category": "Math & Types"},
	"vecz": {"body": "Vector2.ZERO|CURSOR|", "description": "Vector2.ZERO", "category": "Math & Types"},
	"veiz": {"body": "Vector2i.ZERO|CURSOR|", "description": "Vector2i.ZERO", "category": "Math & Types"},
	"vec3": {"body": "Vector3({x=0}, {y=0}, {z=0})|CURSOR|", "description": "Vector3", "category": "Math & Types"},
	"vec3z": {"body": "Vector3.ZERO|CURSOR|", "description": "Vector3.ZERO", "category": "Math & Types"},
	"color": {"body": "Color({r=1}, {g=1}, {b=1})|CURSOR|", "description": "Color from RGB values (0-1)", "category": "Math & Types"},
	"rect2": {"body": "Rect2({x=0}, {y=0}, {width}, {height})|CURSOR|", "description": "Rect2", "category": "Math & Types"},
	"randf": {"body": "randf_range({min=0.0}, {max=1.0})|CURSOR|", "description": "Random float in a range", "category": "Math & Types"},
	"randi": {"body": "randi_range({min=0}, {max=10})|CURSOR|", "description": "Random integer in a range", "category": "Math & Types"},
	"clamp": {"body": "clamp({value}, {min}, {max})|CURSOR|", "description": "Clamp a value between min and max", "category": "Math & Types"},
	"lerp": {"body": "lerp({from}, {to}, {weight=0.5})|CURSOR|", "description": "Linear interpolation", "category": "Math & Types"},
	"movetoward": {"body": "move_toward({from}, {to}, {delta})|CURSOR|", "description": "Move a value toward a target by a step", "category": "Math & Types"},

	"fread": {"body": "var file = FileAccess.open(\"{path=user://save.dat}\", FileAccess.READ)\nif file:\n\tvar content = file.get_as_text()\n\t|CURSOR|", "description": "Read a text file (FileAccess)", "category": "Files"},
	"fwrite": {"body": "var file = FileAccess.open(\"{path=user://save.dat}\", FileAccess.WRITE)\nif file:\n\tfile.store_string({content})|CURSOR|", "description": "Write a text file (FileAccess)", "category": "Files"},

	"move2d": {"body": "const SPEED = {speed=300.0}\nconst JUMP_VELOCITY = {jump_velocity=-400.0}\n\nvar gravity: float = ProjectSettings.get_setting(\"physics/2d/default_gravity\")\n\nfunc _physics_process(delta: float) -> void:\n\tif not is_on_floor():\n\t\tvelocity.y += gravity * delta\n\tif Input.is_action_just_pressed(\"ui_accept\") and is_on_floor():\n\t\tvelocity.y = JUMP_VELOCITY\n\tvar direction := Input.get_axis(\"ui_left\", \"ui_right\")\n\tif direction:\n\t\tvelocity.x = direction * SPEED\n\telse:\n\t\tvelocity.x = move_toward(velocity.x, 0, SPEED)\n\tmove_and_slide()|CURSOR|", "description": "Platformer movement for CharacterBody2D", "category": "Patterns"},
	"statem": {"body": "enum State { {first=IDLE}, {second=MOVE} }\n\nvar state: State = State.{first}\n\nfunc set_state(new_state: State) -> void:\n\tstate = new_state\n\tmatch state:\n\t\tState.{first}:\n\t\t\tpass\n\t\tState.{second}:\n\t\t\tpass|CURSOR|", "description": "Simple state machine with an enum", "category": "Patterns"}
}
