[sub_resource type="Resource" id="Resource_o1h1j"]
script = ExtResource("107_o0dwx")
character = 0
expression = 2
dialogue_text = "Who are you?"
position = 0

[sub_resource type="Resource" id="Resource_55rnv"]
script = ExtResource("107_o0dwx")
character = 1
expression = 3
dialogue_text = "I am Carmilla, a loyal servant of Lord Dracula.
