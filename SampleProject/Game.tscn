position = 1

[sub_resource type="Resource" id="Resource_2wus2"]
script = ExtResource("107_o0dwx")
character = 0
expression = 2
dialogue_text = "And what is it that you want from me?"
position = 0

[sub_resource type="Resource" id="Resource_bqaak"]
script = ExtResource("107_o0dwx")
character = 1
expression = 2
dialogue_text = "I am here because I want to understand why you side with those scoundrels."
position = 1

[sub_resource type="Resource" id="Resource_jrgt6"]
script = ExtResource("107_o0dwx")
character = 1
expression = 1
dialogue_text = "Why did you abandon and betray us?
