position = 1

[sub_resource type="Resource" id="Resource_eyf3w"]
script = ExtResource("107_o0dwx")
character = 1
expression = 2
dialogue_text = "Because, listen to me, humans prove to be worthless and a danger to us both, again and again."
position = 1

[sub_resource type="Resource" id="Resource_yuuna"]
script = ExtResource("107_o0dwx")
character = 1
expression = 4
dialogue_text = "Humans are weak and frail, Hector.
