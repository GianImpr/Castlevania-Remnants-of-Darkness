position = 0

[sub_resource type="Resource" id="Resource_u1nhv"]
script = ExtResource("107_o0dwx")
character = 1
expression = 1
dialogue_text = "That may be so, but our Lord Dracula is gone and someone has to take his place. His plan cannot stop here."
position = 1

[sub_resource type="Resource" id="Resource_v57uc"]
script = ExtResource("107_o0dwx")
character = 1
expression = 3
dialogue_text = "I will take his place, as queen of this land.
