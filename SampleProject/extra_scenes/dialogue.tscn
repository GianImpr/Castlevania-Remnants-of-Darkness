[ext_resource type="Script" path="res://SampleProject/Scripts/Event/dialogue_entry.gd" id="2_va3t4"]
[ext_resource type="FontFile" uid="uid://bkqeydh4cq86s" path="res://assets/sprites/Font/McMillen.ttf" id="3_wbmmy"]
[ext_resource type="Texture2D" uid="uid://bwvk1ef3k8yvj" path="res://assets/sprites/HUD/Faces/Carmilla/HalfBody.png" id="4_6a341"]
[ext_resource type="AudioStream" uid="uid://cqcf404qofb42" path="res://assets/sounds/Effects/Miscellaneous/TextSpeech.MP3" id="5_i2a1r"]
[ext_resource type="Texture2D" uid="uid://cmm7ljl15sp6m" path="res://assets/sprites/HUD/Containers/DialogueBox/DialogueCursor.png" id="6_uqomd"]

[sub_resource type="Resource" id="Resource_8f7hp"]
script = ExtResource("2_va3t4")
character = 1
expression = 3
dialogue_text = "Ah, if it isn't Hector: the most interesting man in Dracula's court."
position = 1

[sub_resource type="Resource" id="Resource_wtpr2"]
script = ExtResource("2_va3t4")
character = 1
expression = 0
dialogue_text = "I've come to know of your heroic feat.
You've become a really strong man."
position = 1

[sub_resource type="Resource" id="Resource_o67wt"]
script = ExtResource("2_va3t4")
character = 0
expression = 2
dialogue_text = "Who are you?"
position = 0

[sub_resource type="Resource" id="Resource_55rnv"]
script = ExtResource("2_va3t4")
character = 1
expression = 3
dialogue_text = "I am Carmilla, a loyal servant of Lord Dracula.
And I know everything about you, my dear, sweet Hector."
position = 1

[sub_resource type="Resource" id="Resource_2wus2"]
script = ExtResource("2_va3t4")
character = 0
expression = 2
dialogue_text = "And what is it that you want from me?"
position = 0

[sub_resource type="Resource" id="Resource_bqaak"]
script = ExtResource("2_va3t4")
character = 1
expression = 2
dialogue_text = "I am here because I want to understand why you side with those scoundrels."
position = 1

[sub_resource type="Resource" id="Resource_jrgt6"]
script = ExtResource("2_va3t4")
character = 1
expression = 1
dialogue_text = "Why did you abandon and betray us?
Humans are an ill-suited company for you, so why come back to them?"
position = 1

[sub_resource type="Resource" id="Resource_gx1rt"]
script = ExtResource("2_va3t4")
character = 0
expression = 2
dialogue_text = "...
You're in no position to judge humans."
position = 0

[sub_resource type="Resource" id="Resource_u1nhv"]
script = ExtResource("2_va3t4")
character = 1
expression = 1
dialogue_text = "That may be so, but our Lord Dracula is gone and someone has to take his place. His plan cannot stop here."
position = 1

[sub_resource type="Resource" id="Resource_v57uc"]
script = ExtResource("2_va3t4")
character = 1
expression = 3
dialogue_text = "I will take his place, as queen of this land.
His will shall live on!"
position = 1

[sub_resource type="Resource" id="Resource_eyf3w"]
script = ExtResource("2_va3t4")
character = 1
expression = 2
dialogue_text = "Because, listen to me, humans prove to be worthless and a danger to us both, again and again."
position = 1

[sub_resource type="Resource" id="Resource_yuuna"]
script = ExtResource("2_va3t4")
character = 1
expression = 4
dialogue_text = "Humans are weak and frail, Hector.
Look at them!"
position = 1

[sub_resource type="Resource" id="Resource_pl4eo"]
script = ExtResource("2_va3t4")
character = 1
expression = 0
dialogue_text = "Not only are they the embodiment of weakness.
They also constantly betray each other."
position = 1

[sub_resource type="Resource" id="Resource_ql2g5"]
script = ExtResource("2_va3t4")
character = 1
expression = 0
dialogue_text = "Their greed and selfish dreams know no bounds.
"
position = 1

[sub_resource type="Resource" id="Resource_b1cpc"]
script = ExtResource("2_va3t4")
character = 1
expression = 0
dialogue_text = "They keep slaughtering each other, just for a chance to show their might."
position = 1

[sub_resource type="Resource" id="Resource_yuqnq"]
script = ExtResource("2_va3t4")
character = 1
expression = 0
dialogue_text = "They're no different than animals.
They only seek destruction everywhere."
position = 1

[sub_resource type="Resource" id="Resource_ycdkt"]
script = ExtResource("2_va3t4")
character = 1
expression = 0
dialogue_text = "No matter how much time passes on.
Humans will always be tainted by darkness."
position = 1

[sub_resource type="Resource" id="Resource_bft1l"]
script = ExtResource("2_va3t4")
character = 1
expression = 0
dialogue_text = "A darkness that does not originate from Dracula's influence, no...
It originates from the hearts of humans."
position = 1

[sub_resource type="Resource" id="Resource_abke8"]
script = ExtResource("2_va3t4")
character = 0
expression = 2
dialogue_text = "..."
position = 0

[sub_resource type="Resource" id="Resource_3qvv1"]
script = ExtResource("2_va3t4")
character = 1
expression = 5
dialogue_text = "Hector, poor Hector.
I also know about your beloved woman."
position = 1

[sub_resource type="Resource" id="Resource_nlgtf"]
script = ExtResource("2_va3t4")
character = 1
expression = 0
dialogue_text = "A beautiful, lovely maiden, killed by those heartless creatures."
position = 1

[sub_resource type="Resource" id="Resource_7kcsh"]
script = ExtResource("2_va3t4")
character = 1
expression = 2
dialogue_text = "How can you protect them, knowing that your suffering comes from their ill will?!"
position = 1

[sub_resource type="Resource" id="Resource_mqejh"]
script = ExtResource("2_va3t4")
character = 0
expression = 2
dialogue_text = "Carmilla, you fail to understand.
While humans are sinful creatures, Dracula's Curse amplified that aspect."
position = 0

[sub_resource type="Resource" id="Resource_jnrv7"]
script = ExtResource("2_va3t4")
character = 0
expression = 0
dialogue_text = "It is because of Lord Dracula, that this land is tainted by death.
Famine, misery, violence, grief. All caused by his curse."
position = 0

[sub_resource type="Resource" id="Resource_utlr2"]
script = ExtResource("2_va3t4")
character = 0
expression = 0
dialogue_text = "Her death was only a means for Lord Dracula to punish my betrayal."
position = 0

[sub_resource type="Resource" id="Resource_lc0k7"]
script = ExtResource("2_va3t4")
character = 0
expression = 0
dialogue_text = "You monsters use humans as a tool of death and then blame us for your evil deeds."
position = 0

[sub_resource type="Resource" id="Resource_hfyhw"]
script = ExtResource("2_va3t4")
character = 0
expression = 4
dialogue_text = "She is dead because of fiends like you!"
position = 0

[sub_resource type="Resource" id="Resource_a0e3l"]
script = ExtResource("2_va3t4")
character = 1
expression = 1
dialogue_text = "Foolishness, Hector.
The curse may have enhanced the impulse of the human mind..."
position = 1

[sub_resource type="Resource" id="Resource_l4h0p"]
script = ExtResource("2_va3t4")
character = 1
expression = 0
dialogue_text = "...but they have committed atrocities even before the advent of Dracula's Curse."
position = 1

[sub_resource type="Resource" id="Resource_15a3r"]
script = ExtResource("2_va3t4")
character = 1
expression = 0
dialogue_text = "Do you remember why our Lord Dracula wanted the end of mankind?"
position = 1

[sub_resource type="Resource" id="Resource_4neaj"]
script = ExtResource("2_va3t4")
character = 1
expression = 2
dialogue_text = "Because they committed the same injustice to his beloved.
She suffered the same fate as your woman."
position = 1

[sub_resource type="Resource" id="Resource_2o2y2"]
script = ExtResource("2_va3t4")
character = 1
expression = 4
dialogue_text = "How can you explain that?!"
position = 1

[sub_resource type="Resource" id="Resource_bx3e7"]
script = ExtResource("2_va3t4")
character = 0
expression = 5
dialogue_text = "I am still trying to understand the nature of humans...
But I've come to realize that not everyone is the same."
position = 0

[sub_resource type="Resource" id="Resource_tsqkx"]
script = ExtResource("2_va3t4")
character = 0
expression = 1
dialogue_text = "Some bastards deserve to be punished.
However, some others deserve praise for their kindness."
position = 0

[sub_resource type="Resource" id="Resource_7l514"]
script = ExtResource("2_va3t4")
character = 0
expression = 0
dialogue_text = "I could not feel at home before, but things have changed.
I feel at peace to be with them."
position = 0

[sub_resource type="Resource" id="Resource_8x8d0"]
script = ExtResource("2_va3t4")
character = 1
expression = 3
dialogue_text = "..."
position = 1

[sub_resource type="Resource" id="Resource_upl0l"]
script = ExtResource("2_va3t4")
character = 1
expression = 0
dialogue_text = "Such a naive little boy you are.
I thought you had finally grown up, but clearly, I was wrong."
position = 1

[sub_resource type="Resource" id="Resource_awl76"]
script = ExtResource("2_va3t4")
character = 1
expression = 0
dialogue_text = "I would be happy to hear your cries, once your mortal friends commit another atrocity upon you."
position = 1

[sub_resource type="Resource" id="Resource_ni2ni"]
script = ExtResource("2_va3t4")
character = 1
expression = 1
dialogue_text = "However, my duty has the maximum priority."
position = 1

[sub_resource type="Resource" id="Resource_ue3r3"]
script = ExtResource("2_va3t4")
character = 1
expression = 0
dialogue_text = "Since you were so kind to separate Dracula's magic from his body, you've made things easier for me."
position = 1

[sub_resource type="Resource" id="Resource_67xnv"]
script = ExtResource("2_va3t4")
character = 0
expression = 2
dialogue_text = "What? What do you mean?
I've never done that."
position = 0

[sub_resource type="Resource" id="Resource_j1ehq"]
script = ExtResource("2_va3t4")
character = 1
expression = 3
dialogue_text = "Well then, here's your mission.
Understand what you've done!"
position = 1

[sub_resource type="Resource" id="Resource_ispcp"]
script = ExtResource("2_va3t4")
character = 1
expression = 0
dialogue_text = "We shall meet again, Hector."
position = 1

